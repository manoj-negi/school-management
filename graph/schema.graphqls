# graph/schema.graphqls

# Since ent.graphql will define the base Query and Mutation types,
# we extend the Mutation type here to add custom operations.

extend type Query {
  admissionInquiries: [AdmissionInquiry!]!
  complaints: [Complaint!]!
  visitors: [Visitor!]!
  teachersList: [TeacherInfo!]!
  assignClassTeacherList: [AssignClassTeacher!]!
  classList: [ClassInfo!]!
  studentsList: [StudentInfo!]!
  studentAttendanceList: [StudentAttendanceInfo!]!
  studentPromotionList: [StudentPromotionInfo!]!
  studentCertificateList: [StudentCertificateInfo!]!
  studentDisciplineList: [StudentDisciplineInfo!]!
  studentHealthRecordList: [StudentHealthRecordInfo!]!
  onlineApplications: [OnlineApplication!]!
  entranceExams: [EntranceExam!]!
  meritLists: [MeritList!]!
  seatAllocations: [SeatAllocation!]!
  examTypes: [ExamType!]!
  examSchedules: [ExamSchedule!]!
  hallAllocations: [HallAllocation!]!
  marksEntries: [MarksEntry!]!
}

extend type Mutation {
  login(input: LoginInput!): LoginResponse!
  createAdmissionInquiry(input: CreateAdmissionInquiryInput!): AdmissionInquiry!
  updateAdmissionInquiry(input: UpdateAdmissionInquiryInput!): AdmissionInquiry!
  deleteAdmissionInquiry(inquiryId: String!): String!
  createComplaint(input: CreateComplaintInput!): Complaint!
  updateComplaint(input: UpdateComplaintInput!): Complaint!
  deleteComplaint(complaintId: String!): String!
  createVisitor(input: CreateVisitorInput!): Visitor!
  updateVisitor(input: UpdateVisitorInput!): Visitor!
  deleteVisitor(visitorId: String!): String!
  createTeacher(input: CreateTeacherInfoInput!): TeacherInfo!
  updateTeacher(input: UpdateTeacherInfoInput!): TeacherInfo!
  deleteTeacher(id: String!): String!
  createAssignClassTeacher(input: CreateAssignClassTeacherInput!): AssignClassTeacher!
  updateAssignClassTeacher(input: UpdateAssignClassTeacherInput!): AssignClassTeacher!
  deleteAssignClassTeacher(id: String!): String!
  createStudent(input: CreateStudentInfoInput!): StudentInfo!
  updateStudent(input: UpdateStudentInfoInput!): StudentInfo!
  deleteStudent(id: String!): String!
  createStudentAttendance(input: CreateStudentAttendanceInfoInput!): StudentAttendanceInfo!
  updateStudentAttendance(input: UpdateStudentAttendanceInfoInput!): StudentAttendanceInfo!
  deleteStudentAttendance(id: String!): String!
  createStudentPromotion(input: CreateStudentPromotionInfoInput!): StudentPromotionInfo!
  updateStudentPromotion(input: UpdateStudentPromotionInfoInput!): StudentPromotionInfo!
  deleteStudentPromotion(id: String!): String!
  createStudentCertificate(input: CreateStudentCertificateInfoInput!): StudentCertificateInfo!
  updateStudentCertificate(input: UpdateStudentCertificateInfoInput!): StudentCertificateInfo!
  deleteStudentCertificate(id: String!): String!
  createStudentDiscipline(input: CreateStudentDisciplineInfoInput!): StudentDisciplineInfo!
  updateStudentDiscipline(input: UpdateStudentDisciplineInfoInput!): StudentDisciplineInfo!
  deleteStudentDiscipline(id: String!): String!
  createStudentHealthRecord(input: CreateStudentHealthRecordInfoInput!): StudentHealthRecordInfo!
  updateStudentHealthRecord(input: UpdateStudentHealthRecordInfoInput!): StudentHealthRecordInfo!
  deleteStudentHealthRecord(id: String!): String!
  createOnlineApplication(input: CreateOnlineApplicationInput!): OnlineApplication!
  updateOnlineApplication(input: UpdateOnlineApplicationInput!): OnlineApplication!
  deleteOnlineApplication(id: String!): String!
  createEntranceExam(input: CreateEntranceExamInput!): EntranceExam!
  updateEntranceExam(input: UpdateEntranceExamInput!): EntranceExam!
  deleteEntranceExam(id: String!): String!
  createMeritList(input: CreateMeritListInput!): MeritList!
  updateMeritList(input: UpdateMeritListInput!): MeritList!
  deleteMeritList(id: String!): String!
  createSeatAllocation(input: CreateSeatAllocationInput!): SeatAllocation!
  updateSeatAllocation(input: UpdateSeatAllocationInput!): SeatAllocation!
  deleteSeatAllocation(id: String!): String!
  createExamType(input: CreateExamTypeInput!): ExamType!
  updateExamType(input: UpdateExamTypeInput!): ExamType!
  deleteExamType(id: String!): String!
  createExamSchedule(input: CreateExamScheduleInput!): ExamSchedule!
  updateExamSchedule(input: UpdateExamScheduleInput!): ExamSchedule!
  deleteExamSchedule(id: String!): String!
  createHallAllocation(input: CreateHallAllocationInput!): HallAllocation!
  updateHallAllocation(input: UpdateHallAllocationInput!): HallAllocation!
  deleteHallAllocation(id: String!): String!
  createMarksEntry(input: CreateMarksEntryInput!): MarksEntry!
  updateMarksEntry(input: UpdateMarksEntryInput!): MarksEntry!
  deleteMarksEntry(id: String!): String!
}

